package myMain;
import java.util.Scanner;
import java.util.Arrays;
	public class MainClass {
		static Scanner userinput = new Scanner(System.in);
		public static void main(String[] args){
			int i = 10;
			int[][] pascalTriangle = new int[i][];
				
			for (int s = 0; s < i; s++) {
				pascalTriangle[s] = new int[s + 1];
				pascalTriangle[s][0] = 1;
				pascalTriangle[s][s] = 1;
				
				for (int j = 1; j < s; j++) {
					pascalTriangle[s][j] = pascalTriangle[s -1][j - 1] + pascalTriangle[s - 1][j];
				}
				}
			
			System.out.print("Rows 1-10 of Pascal's Triangle\n");
			for (int s = 0; s < i; s++) {
				for (int j = 0; j <= s; j++) {
					System.out.print(pascalTriangle[s][j] + " ");
				}
			
			System.out.println();
			}
			}	
			
	
	}
	

		
 
